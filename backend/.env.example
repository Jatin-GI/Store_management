PORT=8080
NODE_ENV=development

# Neon (recommended) — use connection string from Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Or separate fields (also works with Neon)
# DB_HOST=ep-xxxx.aws.neon.tech
# DB_NAME=neondb
# DB_USERNAME=your_neon_user
# DB_PASSWORD=your_neon_password

JWT_SECRET_KEY=your-secret-key

# Vercel frontend URL (comma-separated for multiple origins)
FRONTEND_URL=https://your-app.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
